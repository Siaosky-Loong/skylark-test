# BytePlus ModelArk API配置
# 请将此文件重命名为 .env 并填入您的实际API密钥

# 您的BytePlus ModelArk API密钥
# 可以在BytePlus控制台获取: https://console.byteplus.com/
ARK_API_KEY=your_ark_api_key_here

# Flask应用配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=your_secret_key_here

# BytePlus ModelArk API配置
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型默认参数
DEFAULT_TEMPERATURE=1.0
DEFAULT_MAX_TOKENS=1000
DEFAULT_TOP_P=0.7
DEFAULT_FREQUENCY_PENALTY=0.1
DEFAULT_PRESENCE_PENALTY=0.1

# 日志配置
LOG_LEVEL=INFO

# 示例:
# ARK_API_KEY=ak-1234567890abcdef1234567890abcdef